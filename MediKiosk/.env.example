# Backend Configuration
SECRET_KEY=your-secret-key-here-generate-with-python-secrets-library
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db
ENVIRONMENT=development

# CORS Configuration (add your frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://medikiosk-frontend.onrender.com

# Optional: Demo OTP (for testing only - leave empty in production)
DEMO_OTP=

# Document Processing
DOCUMENT_OCR_PROVIDER=mock

# Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
